# Server
PORT=5000
NODE_ENV=development

# MongoDB (local or Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/trustify_trips

# Auth: use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# First admin account, created by `npm run seed` or `npm run create-admin`
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@trustifytrips.in
ADMIN_PASSWORD=ChangeMe@123

# Comma-separated origins allowed to call the API from another domain.
# Leave empty when the portals are served by this same server.
CORS_ORIGINS=

# Set to true to publish traveller reviews without moderation
REVIEW_AUTO_APPROVE=false

# Cloudinary — hosts destination cover images. Optional: leave empty and the
# upload endpoint answers 503 while everything else keeps working (a cover
# image is optional, and a destination without one falls back to its gradient).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=trustify/destinations
